using System;
using System.Linq;
using System.Collections;
using System.Reflection;
using System.IO;
using System.Security.Cryptography;
using UnityEditor;
using UnityEngine;
using UnityEngine.UIElements;
const string expectedName = "__NAME__";
const string expectedId = "__ID__";
const string expectedVersion = "__VERSION__";
const string expectedHash = "__HASH__";
const string path = "/var/lib/unityarpg/.local/share/are-arpg/store-drafts-20261115/__FILE__";
string hash;
using(var sha=SHA256.Create()) hash=BitConverter.ToString(sha.ComputeHash(File.ReadAllBytes(path))).Replace("-", "").ToLowerInvariant();
if(hash!=expectedHash) throw new Exception("Unexpected export checksum");
var flags=BindingFlags.NonPublic|BindingFlags.Public|BindingFlags.Instance;
object Field(object o,string n)=>o.GetType().GetField(n,flags).GetValue(o);
object Prop(object o,string n)=>o.GetType().GetProperty(n).GetValue(o);
var window=Resources.FindObjectsOfTypeAll<EditorWindow>().Single(w=>w.titleContent.text=="Asset Store Uploader");
var elements=window.rootVisualElement.Query<VisualElement>().ToList().Where(v=>v.GetType().FullName=="AssetStoreTools.Uploader.UI.Elements.PackageElement");
var element=elements.Single(e=>(string)Prop(Field(e,"_package"),"PackageId")==expectedId);
var package=Field(element,"_package");
if((string)Prop(package,"Name")!=expectedName || (string)Prop(package,"VersionId")!=expectedVersion || !(bool)Prop(package,"IsDraft")) throw new Exception("Target is not the expected draft");
element.GetType().GetMethod("Select").Invoke(element,null);
var contentElement=Field(element,"_contentElement");
var content=Field(contentElement,"_content");
var workflows=(IEnumerable)content.GetType().GetMethod("GetAvailableWorkflows").Invoke(content,null);
var workflow=workflows.Cast<object>().Single(w=>w.GetType().Name=="UnityPackageWorkflow");
var validity=new object[]{path,null};
if(!(bool)workflow.GetType().GetMethod("IsPathValid").Invoke(workflow,validity))throw new Exception("Invalid package path");
content.GetType().GetMethod("SetActiveWorkflow").Invoke(content,new[]{workflow});
var workflowElement=element.Query<VisualElement>().ToList().Single(e=>e.GetType().Name=="UnityPackageWorkflowElement");
workflowElement.GetType().GetMethod("HandleUnityPackageUploadPathSelection",flags).Invoke(workflowElement,new object[]{path,true});
var upload=workflowElement.Query<VisualElement>().ToList().Single(e=>e.GetType().Name=="PackageUploadElement");
if(!upload.Q<Button>("UploadButton").enabledInHierarchy)throw new Exception("Official upload control disabled");
upload.GetType().GetMethod("Upload",flags).Invoke(upload,null);
new {name=expectedName,packageId=expectedId,versionId=expectedVersion,sha256=hash,officialUploadActionInvoked=true,submittedForReview=false}
