# Unity artifacts
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
*.csproj
*.sln
*.user
*.tmp
*.apk
*.aab
*.keystore
*.jks
# Exception: standalone .NET test project is source-controlled
!Tests/**/*.csproj
# Secrets
.env
.env.*
!.env.example
*.p12
*.pfx
.DS_Store

# Private Asset Store packages, cache and entitlement metadata
*.unitypackage
private-asset-catalog.json
asset-intake-receipts/
.asset-store-cache/

# Account-owned models stay private and are never redistributed through this public repo
/Assets/Resources/ARE/Visuals/*
!/Assets/Resources/ARE/Visuals/README.md
!/Assets/Resources/ARE/Visuals/README.md.meta

# Private Kingdom source stays outside public Git. Only the directory anchor is public.
/Assets/PrivateArt/*
!/Assets/PrivateArt/README.md
!/Assets/PrivateArt/README.md.meta

# Dependencies of privately staged models; never part of the public source tree.
/Assets/PrivateVendor/
/Assets/PrivateVendor.meta

# Private Asset Store UI kit sprites/fonts (e.g. Stone UI) stay outside public Git
/Assets/Resources/ARE/UI/*
!/Assets/Resources/ARE/UI/README.md
!/Assets/Resources/ARE/UI/README.md.meta

# Python verification caches
__pycache__/
*.pyc

# Standalone .NET verification outputs
Tests/**/bin/
Tests/**/obj/
